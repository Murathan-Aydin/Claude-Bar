<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Permet de compiler depuis macOS / Linux (dotnet publish -r win-x64) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <AssemblyName>ClaudeBar</AssemblyName>
    <RootNamespace>ClaudeBar</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Claude Bar</Product>
    <Description>Affiche l'utilisation de Claude.ai dans la zone de notification Windows</Description>
    <Copyright>Copyright (c) 2026 Murathan Aydin</Copyright>

    <!-- Options de publication : voir windows/build.ps1 et windows/build.sh -->
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <!-- Pas de .xml de documentation des dépendances dans le dossier publié -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="ClaudeBar.app.ico" />
  </ItemGroup>

  <!-- Le paquet WebView2 référence aussi son contrôle WPF : inutile ici (WinForms) et source d'un conflit WindowsBase. -->
  <Target Name="RemoveWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
